[22.743166, "o", "\u001b[7A\u001b[49C\u001b[27mD\u001b[27mA\u001b[27mT\u001b[27mA\u001b[27m=\u001b[27m$\u001b[27m(\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27m-\u001b[27ms\u001b[27m \u001b[27m\"\u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27ms\u001b[27m:\u001b[27m/\u001b[27m/e\u001b[27mx\u001b[27ma\u001b[27mm\u001b[27m.\u001b[27ms\u001b[27ma\u001b[27mn\u001b[27ma\u001b[27mn\u001b[27md\u001b[27m.\u001b[27mw\u001b[27mo\u001b[27mr\u001b[27mk\u001b[27me\u001b[27mr\u001b[27ms\u001b[27m.\u001b[27md\u001b[27me\u001b[27mv\u001b[27m/\u001b[27mq\u001b[27mu\u001b[27me\u001b[27ms\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27mD\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27m?\u001b[27me\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27ml\u001b[27m=\u001b[27m2\u001b[27m3\u001b[27mf\u001b[27m2\u001b[27m0\u001b[27m0\u001b[27m3\u001b[27m8\u001b[27m6\u001b[27m0\u001b[27m%\u001b[27m4\u001b[27m0\u001b[27md\u001b[27ms\u001b[27m.\u001b[27ms\u001b[27mt\u001b[27mu\u001b[27md\u001b[27my\u001b[27m.\u001b[27mi\u001b[27mi\u001b[27mt\u001b[27mm\u001b[27m.\u001b[27ma\u001b[27mc\u001b[27m.\u001b[27mi\u001b[27mn\u001b[27m&\u001b[27mq\u001b[27mu\u001b[27mi\u001b[27mzS\u001b[27mi\u001b[27mg\u001b[27mn\u001b[27m=\u001b[27mc\u001b[27mN\u001b[27mp\u001b[27mA\u001b[27mh\u001b[27mP\u001b[27mY\u001b[27mR\u001b[27me\u001b[27mG\u001b[27mQ\u001b[27mn\u001b[27m%\u001b[27m2\u001b[27mB\u001b[27mn\u001b[27mO\u001b[27mc\u001b[27mK\u001b[27ma\u001b[27mN\u001b[27m2\u001b[27mO\u001b[27mO\u001b[27m1\u001b[27m2\u001b[27mJ\u001b[27mY\u001b[27m0\u001b[27mn\u001b[27mt\u001b[27mI\u001b[27mO\u001b[27mV\u001b[27mQ\u001b[27mJ\u001b[27mu\u001b[27mH\u001b[27m%\u001b[27m2\u001b[27mB\u001b[27m9\u001b[27ml\u001b[27m9\u001b[27m%\u001b[27m2\u001b[27mB\u001b[27mY\u001b[27mQ\u001b[27mh\u001b[27mi\u001b[27mh\u001b[27mZ\u001b[27mm\u001b[27mB\u001b[27mc\u001b[27mt\u001b[27mn\u001b[27me\u001b[27m1\u001b[27m1\u001b[27m"]
